APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8000

# Use the Supabase session pooler connection URL. URL-encode the database password.
DATABASE_URL=
ADMIN_USERNAME=admin
# Paste the complete output of npm run admin:password, including the dollar sign.
ADMIN_PASSWORD_HASH=
# Use independent random values with at least 32 characters and keep them stable.
ZORAX_SECRET=
KNOWLEDGE_ENCRYPTION_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# Optional bearer token for external database readiness checks.
READINESS_MONITOR_TOKEN=
